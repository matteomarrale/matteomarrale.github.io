---
// Home (variante 1 «scuro + accento», 27/10): presentazione e Chi sono insieme, Come faccio QA Testing, Progetti, Contatti.
// Testi: testo di Chi sono scritto da Matteo il 27/10 (IT; EN tradotto da Claude, approvato da Matteo il 27/10), CV master e About LinkedIn del 27/10. Frase d'apertura (lead) riscritta da Matteo il 28/10; EN del lead tradotto da Claude il 28/10.
// Il bug report è un riassunto del file «Bugs Report» di Cosmic Chaos (feb 2026) sul drive dell'accademia, letto e basta (DEC-039 punto 4).
import Base from '../layouts/Base.astro';
import { projects, type Lang } from '../data/projects';

const academy = projects.filter((p) => p.group === 'academy');
const personal = projects.filter((p) => p.group === 'personal');

const T = {
  en: {
    cv: '/cv/MatteoMarrale_CV_EN.pdf', cvBtn: 'Download CV', alt: 'Matteo Marrale in a selfie with a black-and-white cat',
    lead: "I'm a Junior QA Tester with Game Designer training.",
    study: "I completed the first year of Strategic Writing &amp; Screenwriting at AIV, and I'm now training as a Game Designer at Digital Bros Game Academy in Milan (October 2025 – summer 2027), where from November 2026 I'm also taking the QA Testing course.",
    before: 'Before the academy I spent two years as an airport security officer at Malpensa (I-SEC): a job that got me used to following strict procedures and noticing details.',
    badges: [['Education', 'Digital Bros Game Academy · 2025–2027'], ['Course', 'DBGA QA Testing · from Nov 2026'], ['Languages', 'Italian · English B1'], ['Engines', 'Unity · Unreal Engine']],
    skills: [
      ['QA &amp; Testing', 'bug reporting, playtesting, sorting feedback (incl. Google Forms), balancing &amp; tuning, reading the GDD for expected behavior'],
      ['Game Design', 'core mechanics, gameplay loop, level design, scoring &amp; progression systems'],
      ['Documentation', 'GDD, bug reports, playtest reports, pitch deck, technical design docs'],
      ['Tools', 'Unity · Unreal Engine · Google Workspace · Figma · Miro · ClickUp · Notion · Git · Claude Code · Claude Cowork'],
    ],
    testing: 'How I do QA Testing', bugH: 'Example bug report · Cosmic Chaos',
    qa: [
      ['cosmic', 'Cosmic Chaos', 'testing, bug reports and balancing analysis up to the final build. I also designed the twist and the enemy patterns and co-wrote the GDD with the team.'],
      ['casino', 'One Hell of a Casino', 'Producer, team of 15. I created the feedback form for the beta testers.'],
      ['nigishida', 'The Hunger of Nigishida', 'after internal testing, I collected the feedback into a list of 17 changes assigned to the team.'],
      ['catnhell', "Cat 'n' Hell! (personal project)", 'playtested the prototype and wrote a list of bugs and fixes toward the 1.0 demo.'],
    ],
    bugSrc: 'From my original Cosmic Chaos bug report (Feb 2026), rewritten in a professional bug-tracker format.',
    projectsH: 'Projects', academyH: 'Academy projects · Digital Bros Game Academy', more: 'Case study', aboutH: 'About me',
    personalH: 'Personal projects', personalP: 'Projects I develop outside the academy (I use Claude Code for programming).', devH: 'In development',
    sealed: [
      ['Fighting Ground', "Hand-to-hand combat inspired by Sifu and a hex world map inspired by For The King; new moves are stolen from enemies' cyberdecks. Beat 'em Up Action RPG · Unreal Engine · combat prototype · working title."],
      ['All Bullets for Me', 'An FPS built on combining weapons and powers. Unreal Engine · early mechanic tests · working title.'],
    ],
    contact: 'Contact', copy: 'Copy email',
  },
  it: {
    cv: '/cv/MatteoMarrale_CV_IT.pdf', cvBtn: 'Scarica il CV', alt: 'Matteo Marrale in un selfie con un gatto bianco e nero',
    lead: 'Sono un Junior QA Tester con un percorso formativo da Game Designer.',
    study: "Ho completato il primo anno di Strategic Writing &amp; Screenwriting all'AIV e oggi mi formo alla Digital Bros Game Academy di Milano (ottobre 2025 – estate 2027) come Game Designer, dove da novembre 2026 seguo anche il corso QA Testing.",
    before: "Prima dell'accademia ho lavorato due anni come guardia di sicurezza aeroportuale a Malpensa (I-SEC): un lavoro che mi ha abituato a seguire procedure rigorose e a notare i dettagli.",
    badges: [['Formazione', 'Digital Bros Game Academy · 2025–2027'], ['Corso', 'QA Testing DBGA · da nov 2026'], ['Lingue', 'Italiano · Inglese B1'], ['Motori', 'Unity · Unreal Engine']],
    skills: [
      ['QA &amp; Testing', 'bug reporting, playtesting, raccolta e ordinamento dei feedback (anche con moduli Google Forms), balancing &amp; tuning, lettura del GDD per capire il comportamento atteso'],
      ['Game Design', 'core mechanics, gameplay loop, level design, scoring &amp; progression systems'],
      ['Documentazione', 'GDD, bug report, report dei playtest, pitch deck, technical design docs'],
      ['Strumenti', 'Unity · Unreal Engine · Google Workspace · Figma · Miro · ClickUp · Notion · Git · Claude Code · Claude Cowork'],
    ],
    testing: 'Come faccio QA Testing', bugH: "Bug report d'esempio · Cosmic Chaos",
    qa: [
      ['cosmic', 'Cosmic Chaos', 'testing, bug report e analisi di bilanciamento fino alla build finale. Ho anche progettato il twist e i pattern dei nemici e scritto il GDD insieme al team.'],
      ['casino', 'One Hell of a Casino', 'Producer, team di 15. Ho creato il modulo di feedback per i tester della beta.'],
      ['nigishida', 'The Hunger of Nigishida', 'dopo il test interno ho raccolto i feedback in una lista di 17 modifiche assegnate al team.'],
      ['catnhell', "Cat 'n' Hell! (progetto personale)", 'playtest del prototipo e lista di bug e correzioni verso la demo 1.0.'],
    ],
    bugSrc: 'Dal mio bug report originale di Cosmic Chaos (feb 2026), riscritto nel formato professionale di un bug tracker.',
    projectsH: 'Progetti', academyH: 'Progetti accademici · Digital Bros Game Academy', more: 'Caso di studio', aboutH: 'Chi sono',
    personalH: 'Progetti personali', personalP: "Progetti che sviluppo fuori dall'accademia (uso Claude Code per la programmazione).", devH: 'In sviluppo',
    sealed: [
      ['Fighting Ground', "Combattimento corpo a corpo ispirato a Sifu e mappa del mondo a esagoni ispirata a For The King; le nuove mosse si rubano dai cyberdeck dei nemici. Picchiaduro Beat 'em Up Action GDR · Unreal Engine · prototipo del combattimento · titolo provvisorio."],
      ['All Bullets for Me', 'Un FPS basato sul combinare armi e poteri. Unreal Engine · primi test delle meccaniche · titolo provvisorio.'],
    ],
    contact: 'Contatti', copy: 'Copia email',
  },
};
// Bug report in italiano e inglese (approvato da Matteo il 27/10). Fatti dal file originale; gravità, frequenza e build date da Matteo.
const BUG = {
  en: {
    title: '[Gameplay] Enemy formation does not spawn after pressing "Retry"',
    meta: [
      ['Project', 'Cosmic Chaos (Unity)'],
      ['Severity', 'Major'],
      ['Repro rate', 'Always'],
      ['Platform', 'PC (Windows) build'],
      ['Area', 'Gameplay · enemy spawn'],
      ['Reported by', 'Matteo Marrale · Feb 2026'],
    ],
    stepsH: 'Steps to reproduce', expectedH: 'Expected result', actualH: 'Actual result', workaroundH: 'Workaround',
    steps: ['Launch the game and press "Play" from the main menu.', 'Lose an attempt.', 'Press "Retry".'],
    expected: 'The enemy formation spawns at the start of the new attempt.',
    actual: 'No enemy formation spawns.',
    workaround: 'Close and reopen the game. Returning to the main menu and pressing "Play" does not fix it.',
  },
  it: {
    title: '[Gameplay] La formazione nemica non compare dopo aver premuto "Retry"',
    meta: [
      ['Progetto', 'Cosmic Chaos (Unity)'],
      ['Gravità', 'Alta (Major)'],
      ['Frequenza', 'Sempre'],
      ['Piattaforma', 'Build PC (Windows)'],
      ['Area', 'Gameplay · spawn dei nemici'],
      ['Segnalato da', 'Matteo Marrale · feb 2026'],
    ],
    stepsH: 'Passi per riprodurre', expectedH: 'Risultato atteso', actualH: 'Risultato ottenuto', workaroundH: 'Soluzione temporanea',
    steps: ['Avvia il gioco e premi "Play" dal menu principale.', 'Perdi un tentativo.', 'Premi "Retry".'],
    expected: "All'inizio del nuovo tentativo compare la formazione nemica.",
    actual: 'Non compare nessuna formazione nemica.',
    workaround: 'Chiudi e riapri il gioco. Tornare al menu principale e premere "Play" non risolve.',
  },
};
const langs: Lang[] = ['en', 'it'];
const role = 'Junior QA Tester | Game Designer';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Matteo Marrale',
  url: Astro.site!.href, image: new URL('/foto-profilo.jpg', Astro.site).href, jobTitle: role,
  email: 'mailto:matteo.marrale.1998@gmail.com',
  affiliation: { '@type': 'EducationalOrganization', name: 'Digital Bros Game Academy', address: { '@type': 'PostalAddress', addressLocality: 'Milano', addressCountry: 'IT' } },
  sameAs: ['https://www.linkedin.com/in/matteomarrale/', 'https://github.com/matteomarrale', 'https://matteomarrale.itch.io'],
};
---
<Base title={`Matteo Marrale — ${role}`} path="/" jsonLd={jsonLd}
  description="Portfolio of Matteo Marrale, Junior QA Tester and Game Designer training at Digital Bros Game Academy in Milan: five academy projects and personal projects.">

{/* Direzione A (approvata da Matteo il 28/10; struttura di Claude): stessi testi, nuova struttura. Righe di registro al posto delle card, bug report a tutta larghezza. */}
<div class="wrap" id="c-about">
{langs.map((l) => (
  <div class="l" lang={l}>
    <div class="hero">
      <div>
        <h1>Matteo <br>Marrale</h1>
        <h2 class="sr">{T[l].aboutH}</h2>
        <p class="role">Junior QA Tester | Game Designer</p>
        <p class="lead">{T[l].lead}</p>
        <p set:html={T[l].study} />
        <p>{T[l].before}</p>
        <a class="cta" href={T[l].cv} target="_blank" rel="noopener" hreflang={l}>{T[l].cvBtn}</a>
      </div>
      <aside class="sheet">
        <img src="/foto-profilo.jpg" width="480" height="480" alt={T[l].alt}>
        <dl>{T[l].badges.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </aside>
    </div>
    <dl class="skills">{T[l].skills.map(([k, v]) => <div><dt set:html={k} /><dd set:html={v} /></div>)}</dl>
  </div>
))}
</div>

<section class="blk" id="c-testing"><div class="wrap">
{langs.map((l) => (
  <div class="l" lang={l}>
    <h2>{T[l].testing}</h2>
    <p class="intro">{T[l].bugSrc}</p>
    <article class="ticket" aria-label={T[l].bugH}>
      <div class="ticket-head"><span class="id">#1</span><h3>{BUG[l].title}</h3></div>
      <div class="ticket-grid">
        <div class="ticket-body">
          <h4>{BUG[l].stepsH}</h4>
          <ol>{BUG[l].steps.map((x) => <li>{x}</li>)}</ol>
          <h4>{BUG[l].expectedH}</h4>
          <p>{BUG[l].expected}</p>
          <h4>{BUG[l].actualH}</h4>
          <p>{BUG[l].actual}</p>
          <h4>{BUG[l].workaroundH}</h4>
          <p>{BUG[l].workaround}</p>
        </div>
        <dl class="fields ticket-meta">{BUG[l].meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
    </article>
    <ul class="qa">{T[l].qa.map(([slug, name, txt]) => <li><a href={`/projects/${slug}/`}>{name}</a>{txt}</li>)}</ul>
  </div>
))}
</div></section>

<section class="blk" id="c-projects"><div class="wrap">
{langs.map((l) => (
  <div class="l" lang={l}>
    <h2>{T[l].projectsH}</h2>
    {[[T[l].academyH, academy, ''], [T[l].personalH, personal, T[l].personalP]].map(([h, list, p]) => (
      <>
        <h3 class="grp">{h}</h3>
        {p && <p class="intro">{p}</p>}
        <ul class="log">
          {(list as typeof projects).map((pr) => (
            <li><a class="row" href={`/projects/${pr.slug}/`}>
              <div class="att" data-dev>{pr[l].dev?.[0]}</div>
              <div>
                <p class="when">{pr[l].card.meta}</p>
                <h4>{pr.title}</h4>
                <p>{pr[l].context}</p>
                <span class="go">{T[l].more}</span>
              </div>
              <div>
                <p class="who" set:html={pr[l].card.line} />
                {pr[l].card.tags.length > 0 && <ul class="tags">{pr[l].card.tags.map((t) => <li>{t}</li>)}</ul>}
              </div>
            </a></li>
          ))}
        </ul>
      </>
    ))}
    <h3 class="grp">{T[l].devH}</h3>
    <ul class="sealed">{T[l].sealed.map(([n, d]) => <li><b>{n}</b>{d}</li>)}</ul>
  </div>
))}
</div></section>

<section class="blk contact" id="c-contact"><div class="wrap">
{langs.map((l) => (
  <div class="l" lang={l}>
    <h2>{T[l].contact}</h2>
    <a class="mail" href="mailto:matteo.marrale.1998@gmail.com">matteo.marrale.1998@gmail.com</a>
    <div class="links">
      <button class="cta" type="button" data-copy>{T[l].copy}</button>
      <a href="https://www.linkedin.com/in/matteomarrale/" target="_blank" rel="me noopener">LinkedIn</a>
      <a href="https://github.com/matteomarrale" target="_blank" rel="me noopener">GitHub</a>
      <a href="https://matteomarrale.itch.io" target="_blank" rel="me noopener">Itch.io</a>
      <a href={T[l].cv} target="_blank" rel="noopener" hreflang={l}>{T[l].cvBtn}</a>
    </div>
    <p class="toast" role="status" aria-live="polite"></p>
  </div>
))}
</div></section>
</Base>
